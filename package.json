{
  "name": "uxie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @uxie/web dev",
    "dev:desktop": "pnpm --filter @uxie/desktop dev",
    "build:web": "pnpm --filter @uxie/web build",
    "build:desktop": "pnpm --filter @uxie/desktop build",
    "typecheck": "pnpm --filter @uxie/web typecheck && pnpm --filter @uxie/desktop typecheck",
    "lint": "pnpm --filter @uxie/web lint",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "release": "bash scripts/release.sh"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-pdf-highlighter@6.1.0": "patches/react-pdf-highlighter@6.1.0.patch"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "canvas",
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@9.14.2"
}
