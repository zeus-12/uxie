# --- Core ---
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Database (Supabase Postgres) ---
DATABASE_URL=

# --- Google OAuth (sign-in) ---
# Authorised redirect URI: $NEXTAUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Gemini (chat, completion, flashcards, summaries) ---
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Uploadthing (PDF storage) ---
UPLOADTHING_TOKEN=

# --- Pinecone (embedding storage for RAG) ---
# Index must be 768-dimensional, cosine metric — matches BAAI/bge-base-en-v1.5.
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- Hugging Face (embedding inference) ---
HUGGINGFACE_API_KEY=

# --- Supabase client (used by the db-dump script) ---
PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Liveblocks (realtime collaboration) ---
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_API_KEY=

# --- Optional ---
NEXT_PUBLIC_ENV=development
# Set to 1 to stub AI completion responses instead of calling Gemini.
MOCK_AI=