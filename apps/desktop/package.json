{
  "name": "@uxie/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Uxie desktop — local-first PDF reader",
  "author": "Uxie",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "pretest": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack": "electron-rebuild -f -w better-sqlite3 && electron-vite build && electron-builder --mac",
    "pack:dmg": "electron-rebuild -f -w better-sqlite3 && electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@paralleldrive/cuid2": "^2.2.2",
    "@shadcn/react": "^0.2.1",
    "@uxie/shared": "workspace:*",
    "ai": "^7.0.22",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.44.6",
    "lucide-react": "^0.563.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "2.16.105",
    "radix-ui": "^1.6.2",
    "react-markdown": "^9.0.0",
    "react-pdf-highlighter": "^6.1.0",
    "sqlite-vec": "^0.1.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.15",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "drizzle-kit": "^0.31.5",
    "electron": "^35",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3",
    "postcss": "^8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
